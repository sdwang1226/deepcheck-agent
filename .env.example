# DeepCheck Agent 环境变量配置 — 复制为 .env 并填入真实凭证

# Longbridge OpenAPI（行情 + 财务数据）https://open.longportapp.com
LONGBRIDGE_APP_KEY=your_app_key_here
LONGBRIDGE_APP_SECRET=your_app_secret_here
LONGBRIDGE_ACCESS_TOKEN=your_access_token_here

# DeepSeek LLM（Agent 大脑）https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- 可选 ----
# LLM / HuggingFace 需要走代理时设置；Longbridge 域名始终直连（代码里已加 NO_PROXY）
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# Embedding 模型已下载到本地缓存时设为 1，避免联网检查
# DEEPCHECK_EMBEDDING_LOCAL_ONLY=1

# 本机 torch < 2.6 且无法升级时设为 1（绕过 transformers 的 torch.load 安全版本检查）
# DEEPCHECK_PATCH_TORCH_CHECK=1

# SEC EDGAR 要求 User-Agent 带联系方式
# SEC_USER_AGENT=DeepCheck Research Agent you@example.com
